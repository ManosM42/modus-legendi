import { useEffect, useState } from "react";
import { createFileRoute } from "@tanstack/react-router";
import { supabase } from "@/supabase/client";
import { useAuth } from "@/contexts/AuthContext";
import { Reveal } from "@/components/site/Reveal";
import { TiltCard } from "@/components/site/TiltCard";
import { UserPlus, UserX, ShieldCheck, ShieldAlert } from "lucide-react";

export const Route = createFileRoute("/admin/editors")({
  component: AdminEditorsPage,
});

interface ProfileWithAuth {
  id: string;
  username: string;
  name: string;
  email: string;
  role: string;
  avatar_url: string | null;
}

function AdminEditorsPage() {
  const { isAdmin, loading: authLoading } = useAuth();
  const [profiles, setProfiles] = useState<ProfileWithAuth[]>([]);
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    if (!authLoading && isAdmin) void loadProfiles();
  }, [authLoading, isAdmin]);

  const loadProfiles = async () => {
    setLoading(true);
    setError(null);
    try {
      // IMPORTANT: The profiles table must have an 'email' column for this to work.
      const { data, error: fetchError } = await supabase
        .from("profiles")
        .select("id, username, name, email, role, avatar_url")
        .order("name", { ascending: true });

      if (fetchError) throw fetchError;
      setProfiles((data as any[]) ?? []);
    } catch (err: any) {
      console.error("Error loading profiles:", err);
      setError(err.message || "Failed to load profiles.");
    } finally {
      setLoading(false);
    }
  };

  const handleToggleRole = async (profileId: string, currentRole: string) => {
    const newRole = currentRole === "allowed_editors" ? "notallowed_editors" : "allowed_editors";
    setSaving(true);
    setError(null);

    const { error } = await supabase
      .from("profiles")
      .update({ role: newRole })
      .eq("id", profileId);

    if (error) {
      setError("Failed to update role. Please try again.");
    } else {
      await loadProfiles();
    }
    setSaving(false);
  };

  const handlePromoteToAdmin = async (profileId: string) => {
    if (!confirm("Are you sure you want to grant full Admin access?")) return;
    setSaving(true);
    setError(null);

    const { error } = await supabase
      .from("profiles")
      .update({ role: "admin" })
      .eq("id", profileId);

    if (error) {
      setError("Failed to promote to admin.");
    } else {
      await loadProfiles();
    }
    setSaving(false);
  };

  if (authLoading) {
    return <div className="min-h-screen bg-background" />;
  }

  if (!isAdmin) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-background px-4">
        <p className="text-sm text-muted-foreground">Δεν έχεις πρόσβαση σε αυτή τη σελίδα.</p>
      </div>
    );
  }

  const allowed = profiles.filter(p => p.role === "allowed_editors");
  const notAllowed = profiles.filter(p => p.role === "notallowed_editors");

  return (
    <div className="min-h-screen bg-background px-4 py-16 sm:py-20">
      <div className="mx-auto max-w-6xl">
        <header className="mb-12">
          <p className="font-mono text-xs uppercase tracking-[0.2em] text-accent font-bold">
            Access Management
          </p>
          <h1 className="mt-2 font-display text-3xl text-foreground sm:text-4xl">
            Διαχείριση Ρόλων
          </h1>
          <p className="mt-3 text-sm leading-relaxed text-muted-foreground max-w-2xl">
            Διαχείριση πρόσβασης για τους συντάκτες του περιοδικού.
            Οι "Επιτρεπτοί" μπορούν να δημοσιεύουν άρθρα.
          </p>
        </header>

        {loading ? (
          <div className="grid gap-8 md:grid-cols-2">
            {[1, 2].map(i => (
              <div key={i} className="h-64 animate-pulse rounded-3xl border border-border bg-card/50" />
            ))}
          </div>
        ) : (
          <div className="grid gap-12 md:grid-cols-2">

            {/* BOARD 1: ALLOWED EDITORS */}
            <section className="flex flex-col">
              <div className="flex items-center gap-3 mb-6">
                <div className="p-2 rounded-lg bg-accent text-white">
                  <ShieldCheck className="size-5" />
                </div>
                <h2 className="text-xl font-display font-semibold">Allowed Editors</h2>
                <span className="ml-auto px-2 py-0.5 rounded-full bg-accent/10 text-accent text-xs font-mono">
                  {allowed.length}
                </span>
              </div>

              <div className="grid gap-4">
                {allowed.length === 0 ? (
                  <div className="p-8 text-center border border-dashed border-border rounded-3xl text-muted-foreground text-sm italic">
                    Δεν υπάρχουν επιτρεπτοί συντάκτες.
                  </div>
                ) : (
                  allowed.map((profile, i) => (
                    <Reveal key={profile.id} delay={i * 50}>
                      <TiltCard>
                        <div className="flex items-center justify-between p-4 rounded-2xl border border-border bg-card hover:border-accent transition-colors group">
                          <div className="flex items-center gap-4">
                            <div className="relative">
                              {profile.avatar_url ? (
                                <img src={profile.avatar_url} className="size-10 rounded-full object-cover border border-border" alt="" />
                              ) : (
                                <div className="size-10 rounded-full bg-secondary flex items-center justify-center text-xs font-bold">
                                  {profile.name?.charAt(0).toUpperCase()}
                                </div>
                              )}
                            </div>
                            <div>
                              <p className="text-sm font-medium text-foreground">{profile.name}</p>
                              <p className="text-xs text-muted-foreground font-mono">{profile.email}</p>
                            </div>
                          </div>
                          <div className="flex items-center gap-2">
                            <button
                              onClick={() => handlePromoteToAdmin(profile.id)}
                              className="p-2 rounded-lg text-muted-foreground hover:text-accent transition-colors"
                              title="Promote to Admin"
                            >
                              <ShieldCheck className="size-4" />
                            </button>
                            <button
                              onClick={() => handleToggleRole(profile.id, profile.role)}
                              className="p-2 rounded-lg text-muted-foreground hover:text-destructive transition-colors"
                              title="Revoke Access"
                            >
                              <UserX className="size-4" />
                            </button>
                          </div>
                        </div>
                      </TiltCard>
                    </Reveal>
                  ))
                )}
              </div>
            </section>

            {/* BOARD 2: NOT ALLOWED EDITORS */}
            <section className="flex flex-col">
              <div className="flex items-center gap-3 mb-6">
                <div className="p-2 rounded-lg bg-secondary text-muted-foreground">
                  <ShieldAlert className="size-5" />
                </div>
                <h2 className="text-xl font-display font-semibold">Pending / Restricted</h2>
                <span className="ml-auto px-2 py-0.5 rounded-full bg-secondary/20 text-muted-foreground text-xs font-mono">
                  {notAllowed.length}
                </span>
              </div>

              <div className="grid gap-4">
                {notAllowed.length === 0 ? (
                  <div className="p-8 text-center border border-dashed border-border rounded-3xl text-muted-foreground text-sm italic">
                    Όλοι οι χρήστες έχουν πρόσβαση.
                  </div>
                ) : (
                  notAllowed.map((profile, i) => (
                    <Reveal key={profile.id} delay={i * 50}>
                      <TiltCard>
                        <div className="flex items-center justify-between p-4 rounded-2xl border border-border bg-card hover:border-accent transition-colors group">
                          <div className="flex items-center gap-4">
                            <div className="relative">
                              {profile.avatar_url ? (
                                <img src={profile.avatar_url} className="size-10 rounded-full object-cover border border-border" alt="" />
                              ) : (
                                <div className="size-10 rounded-full bg-secondary flex items-center justify-center text-xs font-bold">
                                  {profile.name?.charAt(0).toUpperCase()}
                                </div>
                              )}
                            </div>
                            <div>
                              <p className="text-sm font-medium text-foreground">{profile.name}</p>
                              <p className="text-xs text-muted-foreground font-mono">{profile.email}</p>
                            </div>
                          </div>
                          <button
                            onClick={() => handleToggleRole(profile.id, profile.role)}
                            className="p-2 rounded-lg text-muted-foreground hover:text-accent transition-colors"
                            title="Grant Access"
                          >
                            <UserPlus className="size-4" />
                          </button>
                        </div>
                      </TiltCard>
                    </Reveal>
                  ))
                )}
              </div>
            </section>

          </div>
        )}

        {error && (
          <div className="mt-8 p-4 rounded-xl bg-destructive/10 text-destructive text-sm text-center font-mono">
            {error}
          </div>
        )}

        {saving && (
          <div className="fixed bottom-8 right-8 p-4 rounded-full bg-foreground text-background text-xs font-bold animate-bounce shadow-2xl">
            Updating roles...
          </div>
        )}
      </div>
    </div>
  );
}
