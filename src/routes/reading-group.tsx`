import { useState } from "react";
import { createFileRoute } from "@tanstack/react-router";
import { Check } from "lucide-react";
import { useI18n } from "@/i18n";
import { currentBook, formatDate, meetings, pastReads } from "@/data/content";
import { PageHeader } from "@/components/site/PageHeader";
import { Reveal } from "@/components/site/Reveal";
import { TiltCard } from "@/components/site/TiltCard";
import { cn } from "@/lib/utils";

export const Route = createFileRoute("/reading-group")({
  head: () => ({
    meta: [
      { title: "Λέσχη ανάγνωσης — MODUS LEGENDI" },
      {
        name: "description",
        content:
          "Δύο συναντήσεις τον μήνα, ένα βιβλίο κάθε φορά, κοινές σημειώσεις και ανοιχτή συζήτηση στην Αθήνα και διαδικτυακά.",
      },
      { property: "og:title", content: "Λέσχη ανάγνωσης — MODUS LEGENDI" },
      {
        property: "og:description",
        content: "Ημερολόγιο συναντήσεων, το βιβλίο του μήνα και δηλώσεις συμμετοχής.",
      },
    ],
  }),
  component: ReadingGroupPage,
});

function ReadingGroupPage() {
  const { locale, t } = useI18n();
  const [sent, setSent] = useState(false);
  const [form, setForm] = useState({ name: "", email: "", message: "" });
  const [errors, setErrors] = useState<Record<string, string>>({});

  const submit = (event: React.FormEvent) => {
    event.preventDefault();
    const next: Record<string, string> = {};
    if (!form.name.trim()) next['name'] = t.form.required;
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(form.email)) next['email'] = t.form.invalidEmail;
    setErrors(next);
    if (Object.keys(next).length === 0) setSent(true);
  };

  return (
    <div className="bg-background">
      <PageHeader kicker={t.brand} title={t.group.title} intro={t.group.intro} />

      <section className="mx-auto w-full max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
        <div className="flex flex-col gap-4 mb-12">
          <p className="rule-label text-accent font-bold uppercase tracking-wider">Πώς λειτουργεί</p>
          <h2 className="text-3xl sm:text-4xl font-display">{t.group.howTitle}</h2>
        </div>
        <ol className="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {t.group.how.map((step, index) => (
            <Reveal key={step.title} delay={index * 70}>
              <TiltCard>
                <li className="h-full border border-border bg-card p-8 transition-colors hover:border-accent">
                  <span className="rule-label text-accent font-bold">0{index + 1}</span>
                  <h3 className="mt-4 text-2xl font-display">{step.title}</h3>
                  <p className="mt-3 text-sm leading-relaxed text-muted-foreground sm:text-base">{step.text}</p>
                </li>
              </TiltCard>
            </Reveal>
          ))}
        </ol>
      </section>

      <section className="border-y border-border bg-secondary/30">
        <div className="mx-auto grid w-full max-w-6xl gap-10 px-5 py-14 sm:px-8 sm:py-20 lg:grid-cols-[1fr_1.4fr]">
          <TiltCard>
            <div className="h-full border border-border bg-card p-8 sm:p-10 shadow-xl rounded-3xl">
              <p className="rule-label text-accent font-bold uppercase tracking-wider">
                {t.home.currentRead}
              </p>
              <h2 className="mt-4 text-3xl font-display leading-tight">{currentBook.title}</h2>
              <p className="mt-2 text-sm font-mono text-muted-foreground">
                {currentBook.author} · {currentBook.pages} p.
              </p>
              <p className="mt-6 text-base leading-relaxed text-muted-foreground italic">
                {currentBook.description[locale]}
              </p>
            </div>
          </TiltCard>

          <div>
            <div className="flex flex-col gap-4 mb-8">
              <p className="rule-label text-accent font-bold uppercase tracking-wider">Ημερολόγιο</p>
              <h2 className="text-3xl sm:text-4xl font-display">{t.group.calendar}</h2>
            </div>
            <ul className="divide-y divide-border border-y border-border">
              {meetings.map((meeting) => (
                <li
                  key={meeting.id}
                  className="grid grid-cols-[minmax(0,1fr)_auto] items-start gap-4 py-6 transition-colors hover:bg-secondary/20 px-4 -mx-4"
                >
                  <div className="min-w-0">
                    <p className="font-mono text-xs uppercase tracking-widest text-muted-foreground">
                      {formatDate(meeting.date, locale)} · {meeting.time}
                    </p>
                    <h3 className="mt-2 text-xl font-display leading-snug">{meeting.book}</h3>
                    <p className="text-sm text-muted-foreground">{meeting.bookAuthor}</p>
                    <p className="mt-2 text-sm text-muted-foreground italic">{meeting.focus[locale]}</p>
                    <p className="mt-1 text-xs font-mono text-accent uppercase">{meeting.place[locale]}</p>
                  </div>
                  <div className="shrink-0 text-right">
                    <span className="rule-label block text-accent font-bold uppercase tracking-wider text-[0.65rem]">
                      {t.group[meeting.mode]}
                    </span>
                    <span className="mt-2 block text-sm text-muted-foreground">
                      {meeting.seatsLeft === 0
                        ? t.group.full
                        : `${meeting.seatsLeft} ${t.group.seats}`}
                    </span>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section className="mx-auto w-full max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
        <div className="flex flex-col gap-4 mb-12">
          <p className="rule-label text-accent font-bold uppercase tracking-wider">Αρχείο</p>
          <h2 className="text-3xl sm:text-4xl font-display">{t.group.past}</h2>
        </div>
        <ul className="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {pastReads.map((book, index) => (
            <Reveal key={book.title} delay={index * 70}>
              <TiltCard>
                <li className="h-full border border-border bg-card p-6 transition-colors hover:border-accent">
                  <span className="rule-label text-muted-foreground">{book.year}</span>
                  <h3 className="mt-3 text-xl font-display leading-snug">{book.title}</h3>
                  <p className="text-sm text-muted-foreground">{book.author}</p>
                  <p className="mt-3 text-sm leading-relaxed text-muted-foreground italic">
                    {book.note[locale]}
                  </p>
                </li>
              </TiltCard>
            </Reveal>
          ))}
        </ul>
      </section>

      <section className="border-t border-border bg-secondary/30">
        <div className="mx-auto grid w-full max-w-6xl gap-12 px-5 py-14 sm:px-8 sm:py-20 lg:grid-cols-2">
          <div className="flex flex-col justify-center">
            <p className="rule-label text-accent font-bold uppercase tracking-wider">Συμμετοχή</p>
            <h2 className="text-3xl sm:text-4xl font-display">{t.group.joinTitle}</h2>
            <p className="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
              {t.group.joinText}
            </p>
          </div>
          <div className="relative">
            {sent ? (
              <div className="flex items-start gap-3 border border-accent/40 bg-accent/10 p-6 text-sm text-accent rounded-xl">
                <Check aria-hidden className="mt-0.5 size-4 shrink-0" />
                <span className="font-medium">{t.contact.success}</span>
              </div>
            ) : (
              <TiltCard>
                <form onSubmit={submit} noValidate className="grid gap-6 border border-border bg-card p-8 shadow-2xl rounded-3xl sm:p-10">
                  <div className="space-y-2">
                    <label htmlFor="join-name" className="text-xs font-mono uppercase tracking-widest text-muted-foreground">
                      {t.submissions.fields.name}
                    </label>
                    <input
                      id="join-name"
                      value={form.name}
                      onChange={(v) => setForm({ ...form, name: v.target.value })}
                      className="w-full rounded-lg border border-border bg-background px-4 py-3 text-sm outline-none focus-visible:border-accent transition-colors"
                    />
                    {errors['name'] && <p className="text-xs text-destructive">{errors['name']}</p>}
                  </div>
                  <div className="space-y-2">
                    <label htmlFor="join-email" className="text-xs font-mono uppercase tracking-widest text-muted-foreground">
                      {t.submissions.fields.email}
                    </label>
                    <input
                      id="join-email"
                      type="email"
                      value={form.email}
                      onChange={(v) => setForm({ ...form, email: v.target.value })}
                      className="w-full rounded-lg border border-border bg-background px-4 py-3 text-sm outline-none focus-visible:border-accent transition-colors"
                    />
                    {errors['email'] && <p className="text-xs text-destructive">{errors['email']}</p>}
                  </div>
                  <div className="space-y-2">
                    <label htmlFor="join-message" className="text-xs font-mono uppercase tracking-widest text-muted-foreground">
                      {t.submissions.fields.message}
                    </label>
                    <textarea
                      id="join-message"
                      rows={4}
                      value={form.message}
                      onChange={(v) => setForm({ ...form, message: v.target.value })}
                      className="w-full rounded-lg border border-border bg-background px-4 py-3 text-sm outline-none focus-visible:border-accent transition-colors"
                    />
                  </div>
                  <button
                    type="submit"
                    className="bg-foreground px-8 py-3 text-sm font-bold uppercase tracking-widest text-background transition-all hover:-translate-y-0.5 shadow-lg rounded-lg"
                  >
                    {t.actions.join}
                  </button>
                </form>
              </TiltCard>
            )}
          </div>
        </div>
      </section>
    </div>
  );
}
